# Copy to .env (gitignored) and fill in only the providers you use.
# Never put real values in this tracked file. Empty values are ignored.
# The deployed Worker gets the same names through `wrangler secret put`
# (or a gitignored .dev.vars locally); keys never reach the browser.

# Primary provider for the farmer: vertex | anthropic | openai
FARMER_PROVIDER=anthropic
# Secondary, used once when the primary fails fast (leave empty for rule fallback only)
FARMER_SECONDARY=vertex

# Gemini on Vertex AI (course-funded secondary). Auth: Application Default Credentials locally; a service account in the Worker (open question C7).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite
VERTEX_THINKING_LEVEL=low

# Anthropic (paid by me, not by course credits)
ANTHROPIC_API_KEY=
# Optional: only if using a non-default endpoint
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5
# off = no thinking (Sonnet/Haiku only); adaptive = thinking at ANTHROPIC_EFFORT
ANTHROPIC_THINKING=off
ANTHROPIC_EFFORT=low
# Set to off if the endpoint rejects the server-side refusal fallback beta
ANTHROPIC_FALLBACKS=on

# OpenAI or an OpenAI-compatible endpoint (paid by me, not by course credits)
OPENAI_API_KEY=
# Optional: only if using a non-default endpoint
OPENAI_BASE_URL=
OPENAI_MODEL=
